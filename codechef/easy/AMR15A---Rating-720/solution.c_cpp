#include <stdio.h>

int main() {
    int n;
    scanf("%d", & n);
    int a[n];
    int lucky = 0, unlucky = 0;
    for (int i = 0; i < n; i++) {
        scanf("%d", & a[i]);
        if (a[i] % 2 == 0) {
            lucky++;
        }
        else if (a[i] % 2 != 0)
        {
            unlucky++;
        }
    }
    if (lucky > unlucky)
    {
        printf("READY FOR BATTLE");

    } else
        printf("NOT READY");
}